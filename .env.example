
# ==================================================
# RESTOFY - COMPLETE DEV PROFILE TEMPLATE
# ==================================================

# APPLICATION
APP_NAME=restofy
APP_ENV=dev
COMPOSE_PROJECT_NAME=restofy-dev
SPRING_PROFILES_ACTIVE=dev

# ==================================================
# FRONTEND
# ==================================================

FRONTEND_HOST_PORT=5000
FRONTEND_INTERNAL_PORT=3000

# ==================================================
# API GATEWAY
# ==================================================

API_GATEWAY_HOST_PORT=5050

# ==================================================
# MICROSERVICE HOST PORTS
# ==================================================

AUTH_SERVICE_HOST_PORT=5051
ORDER_SERVICE_HOST_PORT=5052
KITCHEN_SERVICE_HOST_PORT=5053
WAITER_SERVICE_HOST_PORT=5054
MENU_SERVICE_HOST_PORT=5055
QR_SERVICE_HOST_PORT=5056
PAYMENT_SERVICE_HOST_PORT=5057
NOTIFICATION_SERVICE_HOST_PORT=5058
ADMIN_SERVICE_HOST_PORT=5059
RATING_SERVICE_HOST_PORT=5060
MAIL_SERVICE_HOST_PORT=5061
TIMER_SERVICE_HOST_PORT=5062

# COMMON CONTAINER PORT
BACKEND_INTERNAL_PORT=8080

# ==================================================
# POSTGRESQL
# ==================================================

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5489

POSTGRES_USER=restofy
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# DATABASE CONNECTION POOL
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# SERVICE DATABASE NAMES
DB_AUTH_NAME=restofy_auth
DB_ORDER_NAME=restofy_order
DB_KITCHEN_NAME=restofy_kitchen
DB_WAITER_NAME=restofy_waiter
DB_MENU_NAME=restofy_menu
DB_QR_NAME=restofy_qr
DB_PAYMENT_NAME=restofy_payment
DB_NOTIFICATION_NAME=restofy_notification
DB_ADMIN_NAME=restofy_admin
DB_RATING_NAME=restofy_rating
DB_MAIL_NAME=restofy_mail
DB_TIMER_NAME=restofy_timer

# ==================================================
# INTERNAL MICROSERVICE URLS
# ==================================================

API_GATEWAY_INTERNAL_URL=http://api-gateway:8080

AUTH_SERVICE_URL=http://auth-service:8080
ORDER_SERVICE_URL=http://order-service:8080
KITCHEN_SERVICE_URL=http://kitchen-service:8080
WAITER_SERVICE_URL=http://waiter-service:8080
MENU_SERVICE_URL=http://menu-service:8080
QR_SERVICE_URL=http://qr-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8080
NOTIFICATION_SERVICE_URL=http://notification-service:8080
ADMIN_SERVICE_URL=http://admin-service:8080
RATING_SERVICE_URL=http://rating-service:8080
MAIL_SERVICE_URL=http://mail-service:8080
TIMER_SERVICE_URL=http://timer-service:8080

# ==================================================
# RESTCLIENT
# ==================================================

REST_CLIENT_CONNECT_TIMEOUT_MS=3000
REST_CLIENT_READ_TIMEOUT_MS=5000

# ==================================================
# SECURITY
# ==================================================

JWT_ISSUER=restofy-auth
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# QR payload encryption: Base64-encoded 32-byte key; fill only in ignored ENV files.
QR_PAYLOAD_ENCRYPTION_KEY=

# ==================================================
# SWAGGER / OPENAPI
# ==================================================

SWAGGER_ENABLED=true

# ==================================================
# LOGGING
# ==================================================

LOG_LEVEL=INFO
TZ=UTC

# ==================================================
# SONARQUBE
# ==================================================

SONARQUBE_HOST_PORT=5099
SONARQUBE_INTERNAL_PORT=9000

SONAR_HOST_URL=http://localhost:5099
SONAR_TOKEN=

SONAR_BACKEND_PROJECT_KEY=restofy-backend
SONAR_FRONTEND_PROJECT_KEY=restofy-frontend

# Separate local SonarQube database. Fill the password only in ignored profile files.
SONAR_DB_NAME=restofy_sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=

# PUBLIC APPLICATION SETTINGS
FRONTEND_PUBLIC_URL=http://localhost:5000
API_GATEWAY_PUBLIC_URL=http://localhost:5050
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050
CORS_ALLOWED_ORIGINS=http://localhost:5000
