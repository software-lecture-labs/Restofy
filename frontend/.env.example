# Leave empty: the browser calls its own origin and the frontend forwards /api to the Gateway (no CORS preflight).
# Set it only to make the browser call a Gateway directly; that Gateway must then answer CORS preflights.
# Do not add secrets to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=

# Where the frontend server forwards /api to. Optional; the default is the local Gateway.
# API_GATEWAY_URL=http://localhost:5050
